APP_NAME="Restaurant POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional: custom token for /setup/storage-link?token=...
# If empty, token = first 32 chars of sha256(APP_KEY|storage-link)
# SETUP_STORAGE_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=respos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Shared hosting: use file cache (fast, no Redis required).
# Avoid CACHE_STORE=database on cPanel — extra DB round-trips every request.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL — defaults (overridden by Settings → Email / SMTP when configured)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Prefer setting SMTP in Admin → Settings → Email / SMTP (host, port, user, pass, recipients).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Software Owner login (edit Roles → software_owner, Email/SMTP, PWA, Integrations, Avenque AI)
# Seed / reset: php artisan db:seed --class=AdminUserSeeder
SOFTWARE_OWNER_EMAIL=owner@avenque.io
SOFTWARE_OWNER_PASSWORD=password
SOFTWARE_OWNER_PIN=0000

# Avenque AI Agent: configure Gemini API key in Admin → Settings → Avenque AI Agent
# (or Software Owner sidebar). Get a key from https://aistudio.google.com/apikey

# -----------------------------------------------------------------------------
# cPanel / shared hosting (production) — copy these values on the live server:
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# LOG_LEVEL=error
# CACHE_STORE=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=database
#
# After deploy, SSH or Terminal in cPanel and run:
#   php artisan optimize:hosting
#   php artisan storage:link
#
# Also enable OPcache in cPanel → MultiPHP INI Editor.
# Document root must point to /public (not the project root).
# If root must stay at project folder, keep the root .htaccess (rewrites into /public).
#
# First-time setup: open https://your-domain.com/install
# Soft delete storage/app/installed only when you intentionally re-run the installer.
